# ============================================================
# .env.local  –  Local development secrets (safe placeholder values)
# Copy this file and fill in real values if needed.
# DO NOT commit real secrets to git.
# ============================================================

# PostgreSQL credentials
POSTGRES_USER=eventify_user
POSTGRES_PASSWORD=eventify_local_pass

# JWT (must be ≥32 characters)
JWT_SECRET=local-dev-jwt-secret-change-me-in-production-32chars

# Admin email (for approval notification emails, viewable in MailHog UI)
ADMIN_EMAIL=admin@localhost

# Sender email (shown as From: in MailHog UI)
SENDER_EMAIL=noreply@localhost
