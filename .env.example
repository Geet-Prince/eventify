# ============================================================
# Eventify Environment Variables (.env.example)
#
# DO NOT commit real credentials or .env files to GitHub.
# Copy this file to:
#   - .env.local       (for local Docker container testing)
#   - live.env or .env (for production / Render values)
# ============================================================

# ── Database Configuration ────────────────────────────────────
# Local Docker:
POSTGRES_USER=eventify_user
POSTGRES_PASSWORD=your_secure_password_here

# Render Production (Render Managed PostgreSQL provides these):
# SPRING_DATASOURCE_URL=postgres://eventify_user:password@dpg-xxxxxx.oregon-postgres.render.com:5432/eventify
# (The backend automatically converts postgres:// to jdbc:postgresql://)
# SPRING_DATASOURCE_USERNAME=eventify_user
# SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# ── JWT Security (Min 32 characters) ──────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your_32_character_minimum_random_secret_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Email & SMTP (Brevo) ──────────────────────────────────────
# Production: Brevo SMTP Relay
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_brevo_smtp_login@smtp-brevo.com
SPRING_MAIL_PASSWORD=xsmtpsib-your_brevo_smtp_key_here

# ── Application URLs & Identities ─────────────────────────────
# Local:
# APP_BASE_URL=http://localhost:8080
# APP_FRONTEND_URL=http://localhost:3000

# Production:
APP_BASE_URL=https://eventify-backend-bcb0.onrender.com
APP_FRONTEND_URL=https://eventify.geetprince.me
ADMIN_EMAIL=your_admin_email@domain.com
SENDER_EMAIL=your_verified_sender_email@domain.com

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://eventify-frontend-beta.vercel.app,https://eventify.geetprince.me,http://localhost:3000,http://localhost:5173
